# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "PrusaSlicer")
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_VERSION "2.9.7")
set(SLIC3R_BUILD_ID "PrusaSlicer-${SLIC3R_VERSION}+UNKNOWN")
set(SLIC3R_RC_VERSION "2,9,7,0")
set(SLIC3R_RC_VERSION_DOTS "2.9.7.0")

set(_project_branding "${CMAKE_CURRENT_LIST_DIR}/build-utils/project-branding.iss")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_project_branding}")
file(STRINGS "${_project_branding}" _project_name REGEX "^#define ProjectName ")
file(STRINGS "${_project_branding}" _project_version REGEX "^#define ProjectVersion ")
string(REGEX REPLACE "^#define ProjectName \"([^\"]+)\"$" "\\1" MEASURE_SECTION_NAME "${_project_name}")
string(REGEX REPLACE "^#define ProjectVersion \"([0-9.]+)\"$" "\\1" MEASURE_SECTION_VERSION "${_project_version}")
string(REPLACE "." "," MEASURE_SECTION_RC_VERSION "${MEASURE_SECTION_VERSION}")
