{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "Prusa Research"
   VALUE "FileDescription", "@MEASURE_SECTION_NAME@ @MEASURE_SECTION_VERSION@"
   VALUE "FileVersion", "@MEASURE_SECTION_VERSION@"
   VALUE "ProductName", "@MEASURE_SECTION_NAME@"
   VALUE "ProductVersion", "@MEASURE_SECTION_VERSION@"
   VALUE "InternalName", "@SLIC3R_APP_NAME@"
   VALUE "LegalCopyright", "Copyright \251 2016-2026 Prusa Research, \251 2011-2018 Alessandro Ranellucci"
   VALUE "OriginalFilename", "prusa-slicer.exe"
  }
 }
 BLOCK "VarFileInfo"
 {
   VALUE "Translation", 0x409, 1252
 }
}
